# Copy to .dev.vars for local `wrangler dev`. Never commit .dev.vars.
ANTHROPIC_API_KEY=sk-ant-...
# Bearer token for /admin/* (scripts/backfill.ts and friends read it from here).
ADMIN_TOKEN=...
# Newsletter. Resend API key (sending only) and a 32-byte hex secret for confirmation links and address hashes.
RESEND_API_KEY=re_...
TOKEN_HMAC_SECRET=...
# Turnstile test keys (always pass); the real widget's keys go in production only.
TURNSTILE_SITE_KEY=1x00000000000000000000AA
TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
# Svix signing secret from the Resend webhook page (whsec_...).
RESEND_WEBHOOK_SECRET=whsec_...
